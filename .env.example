# Copy to .env.local and fill in. Never commit .env.local.
# With these empty, Binged runs in mock mode: seed restaurants and a stand-in for sign-in.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Places API (New) + Routes API. Server only.
GOOGLE_MAPS_SERVER_KEY=
# Maps JavaScript + Autocomplete for the location picker. Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Demo mode only (no Supabase yet): 32+ random characters. Required if demo mode runs in production.
MOCK_SESSION_SECRET=

# Production: the https address friends open, no trailing slash. Leave empty locally (links use the address you browse on).
NEXT_PUBLIC_APP_URL=
POSTHOG_KEY=
